PROJECT_NAME=__PROJECT_NAME__
SUBDOMAIN=__SUBDOMAIN__
APP_DOMAIN=__APP_DOMAIN__

# PocketBase settings
PB_DATA_DIR=/data
PB_HTTP_ADDR=0.0.0.0:8090

# Postgres connection (used by fondoger/pocketbase image)
POSTGRES_URL=postgres://__PB_DB_USER__:__PB_DB_PASSWORD__@__POSTGRES_HOST__:5432/__PB_DATA_DB__?sslmode=disable
POSTGRES_DATA_DB=__PB_DATA_DB__
POSTGRES_AUX_DB=__PB_AUX_DB__
