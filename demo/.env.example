# ── Domain ────────────────────────────────────────────────────────────────────
# Base domain. Instances will be reachable at <subdomain>.<APP_DOMAIN>.
APP_DOMAIN=pocket-hub.domain.com

# ── Dashboard auth ─────────────────────────────────────────────────────────────
# HTTP Basic Auth credentials for the dashboard.
# Leave DASHBOARD_USER empty (or remove it) to disable authentication entirely.
DASHBOARD_USER=admin
DASHBOARD_PASS=changeme

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_please
