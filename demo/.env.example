# ── Domain ────────────────────────────────────────────────────────────────────
# Base domain. Instances will be reachable at <subdomain>.<APP_DOMAIN>.
APP_DOMAIN=pocket-hub.domain.com

# ── Dashboard auth ─────────────────────────────────────────────────────────────
# HTTP Basic Auth credentials for the dashboard.
# Leave DASHBOARD_USER empty (or remove it) to disable authentication entirely.
DASHBOARD_USER=admin
DASHBOARD_PASS=changeme

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_please

# ── Traefik auto-discovery (optional) ─────────────────────────────────────────
# Name of the cert resolver configured in your public Traefik instance.
# Used by the labels in docker-compose.yml to request a wildcard TLS certificate.
# Common values: letsencrypt, cloudflare, myresolver
# Only needed if you are using Traefik as your public reverse proxy.
CERT_RESOLVER=letsencrypt
